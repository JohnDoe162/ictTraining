//@version=6
// =====================================================================================
// ICT Draw on Liquidity - model scored (MGC, 1 hour)
//
// Marks every live draw on liquidity (an untouched prior 1h swing high or low) and scores
// it 0-100%. The score is the model's estimate that the level will be TRADED THROUGH by at
// least 1 tick before the opposite reference swing is traded through, within the same
// trading session. The model is the L2-regularised logistic regression described in
// METHOD.md, version v1_arrayA.
//
// WHY IT EXISTS: to confirm the model by eye. The table in the corner tallies, over all
// loaded chart history, how often each score band was actually reached. If the model works,
// the hit rate rises down the table and the bottom band sits far above the top band.
//
// WHAT IT IS NOT: not a trade signal, not a strategy, not tested after costs.
// This script places no orders.
//
// REQUIREMENTS: 1-hour chart, MGC (Micro Gold). Other symbols or timeframes are untested.
//
// IF THE SCRIPT APPEARS IN ITS OWN PANEL: remove the indicator from the chart and add it
// again. Saving in the Pine Editor updates the code of an instance already on the chart but
// never moves it between panes, so an instance first added while the code was broken stays
// in its own panel for good. The drawings are pinned to the price pane either way, but the
// table belongs to whichever pane owns the script and cannot be moved by code.
// Scoring begins once the volatility-regime window has filled (about 460 one-hour bars).
//
// Model fitted on 19,554 resolved episodes, 2018-01-01..2025-10-17 (sealed holdout excluded).
// Out-of-sample evidence, 13 purged walk-forward windows on this exact 1h-only logic:
// AUC 0.714, top-decile hit rate 85.4% against a 52.6% base rate, every window positive.
// =====================================================================================

indicator("ICT Draw on Liquidity - model scored", "DOL model", overlay = true, max_lines_count = 500, max_labels_count = 500)

// ------------------------------- inputs ---------------------------------------------
grpD = "Display"
showAlive    = input.bool(true,  "Show live draws",                   group = grpD)
showResolved = input.bool(true,  "Keep resolved draws on the chart",  group = grpD)
minLabel     = input.float(0.60, "Label scores at or above",      minval = 0.0, maxval = 1.0, step = 0.05, group = grpD)
minDraw      = input.float(0.00, "Draw lines for scores at or above", minval = 0.0, maxval = 1.0, step = 0.05, group = grpD)
showTable    = input.bool(true,  "Show hit-rate table",               group = grpD)
theme        = input.string("Auto", "Colour theme", options = ["Auto", "Light", "Dark"], group = grpD, tooltip = "Auto reads the chart background. Set it explicitly if your theme is unusual.")
tablePos     = input.string("Top right", "Table position", options = ["Top right", "Bottom right", "Bottom left"], group = grpD)

grpM = "Model"
modelTick  = input.float(0.10, "Tick size the model was fitted on (MGC = 0.10)", minval = 0.0001, step = 0.01, group = grpM, tooltip = "Scales the distance-in-ticks feature. Leave at 0.10 unless the model is refitted.")
atrMedLen  = input.int(460,  "Volatility-regime window (1h bars)", minval = 20, maxval = 2000, group = grpM, tooltip = "460 bars is about 20 trading days, matching the research code. Lower it if the script times out, at the cost of matching the research exactly.")
maxTracked = input.int(800,  "Maximum candidates held in memory",  minval = 50, maxval = 3000, group = grpM, tooltip = "The peak actually needed on MGC 2018-2025 was 386. The cap only protects against runaway memory.")

// ------------------------------- model constants ------------------------------------
// Logistic regression, L2 (C = 1.0). Each feature is standardised with its own mean and
// standard deviation, weighted, summed, then passed through the logistic function.
// Source of every number: reports/pattern_arrays/arrayA_model_pine.json
C_INT = 0.063218
// distance to the level, in ATR
W_01 = -0.918122
M_01 =  1.057067
S_01 =  0.822558
// distance to the level, in ticks
W_02 = -0.100756
M_02 = 53.606474
S_02 = 58.657220
// swing strength: how many earlier bars the pivot towers over
W_03 =  0.242086
M_03 =  8.311292
S_03 =  7.627436
// swing strength: sharpness against its neighbours, in ATR
W_04 =  0.028185
M_04 =  0.241722
S_04 =  0.255913
// age of the level, in sessions
W_05 =  0.067557
M_05 =  0.238366
S_05 =  0.457232
// approaches that came close but did not break it
W_06 = -0.088954
M_06 =  0.561624
S_06 =  1.482540
// volatility regime
W_07 =  0.021932
M_07 =  1.051426
S_07 =  0.376258
// side: +1 high, -1 low
W_08 = -0.001902
M_08 = -0.011660
S_08 =  0.999932
// position of price in the recent range
W_09 = -0.029792
M_09 =  0.527200
S_09 =  0.269215
// London session
W_10 =  0.143316
M_10 =  0.287051
S_10 =  0.452386
// New York morning
W_11 =  0.087918
M_11 =  0.072159
S_11 =  0.258751
// New York afternoon
W_12 =  0.145444
M_12 =  0.079575
S_12 =  0.270633

STRENGTH_CAP   = 20
RANGE_BARS     = 20
TESTS_BAND_ATR = 1.0
RETIRE_SESSION = 30

// ------------------------------- colours --------------------------------------------
// Light and dark are two selected palettes, each checked against its own surface for
// colour-blind separation and contrast. Dark is not an automatic flip of light.
bgLum  = 0.299 * color.r(chart.bg_color) + 0.587 * color.g(chart.bg_color) + 0.114 * color.b(chart.bg_color)
isDark = theme == "Auto" ? bgLum < 128 : theme == "Dark"

C_LOW     = isDark ? color.new(#7a7a74, 20) : color.new(#9a9a94, 20)
C_HIGH    = isDark ? #3987e5 : #2a78d6
C_REACHED = isDark ? #199e70 : #1baf7a
C_MISSED  = isDark ? #d95926 : #eb6834
C_STALE   = isDark ? color.new(#7a7a74, 55) : color.new(#9a9a94, 55)
C_SURFACE = isDark ? #1a1a19 : #fcfcfb      // opaque: the table must never show through
C_INK     = isDark ? #f0efec : #0b0b0b
C_INK2    = isDark ? #c3c2b7 : #52514e
C_HEAD    = isDark ? #1e3f66 : #a8c8ee      // table header, opaque
C_TINT    = isDark ? #17304d : #cfe0f5      // strongest band shade, opaque
C_FRAME   = isDark ? #3a3a37 : #e4e3df

// ------------------------------- guards ---------------------------------------------
if barstate.islast and timeframe.period != "60"
    runtime.error("Put the chart on the 1-hour timeframe. This model was trained on 1h bars only.")

max_bars_back(high, 500)
max_bars_back(low, 500)

// ------------------------------- session --------------------------------------------
// A CME trading day runs 18:00 to 17:00 New York. Shifting by 6 hours puts every bar on its
// own trading day; the exchange calendar handles daylight saving.
NY = "America/New_York"
t6 = time + 6 * 60 * 60 * 1000
sessId = year(t6, NY) * 10000 + month(t6, NY) * 100 + dayofmonth(t6, NY)
newSession = sessId != sessId[1]
nyHour = hour(time, NY) + minute(time, NY) / 60.0

// Session buckets as used in training. Asia is the baseline and carries no feature.
bLondon = nyHour >= 3.0  and nyHour < 9.5  ? 1.0 : 0.0
bNyAm   = nyHour >= 9.5  and nyHour < 12.0 ? 1.0 : 0.0
bNyPm   = nyHour >= 12.0 and nyHour < 17.0 ? 1.0 : 0.0

// ------------------------------- volatility and range -------------------------------
// Simple mean of true range, matching the research code. NOT Wilder's smoothing.
atr     = ta.sma(ta.tr(true), 14)
atrMed  = ta.median(atr, atrMedLen)
atrNorm = na(atrMed) or atrMed <= 0 ? na : atr / atrMed
rngHi   = ta.highest(high, RANGE_BARS)
rngLo   = ta.lowest(low, RANGE_BARS)
rngPos  = rngHi - rngLo > 0 ? (close - rngLo) / (rngHi - rngLo) : 0.5

tick = modelTick
eps  = tick * 0.01

// ------------------------------- candidate ------------------------------------------
type Cand
    float lvl        = na    // the level itself: a pivot high (+1) or pivot low (-1)
    int   side       = 0
    int   confBar    = 0     // bar index at which the pivot became knowable
    float leftStr    = 0.0   // learned swing strength: earlier bars the pivot towers over
    float prom       = 0.0   // learned swing strength: sharpness, in ATR
    int   tests      = 0     // approaches within 1 ATR that did not trade through
    bool  levelAlive = true  // false once the level is traded through: never a draw again
    bool  tracking   = true  // false once an episode resolved or the level retired
    bool  epOpen     = false // an episode (one session) is running
    float epScore    = na
    float refLvl     = na    // opposite-side reference level: trading through it invalidates
    int   refSide    = 0
    int   ageSess    = 0
    line  ln         = na
    label lb         = na

var array<Cand> cands = array.new<Cand>()

// ------------------------------- tallies --------------------------------------------
var array<int> bandN   = array.from(0, 0, 0, 0, 0)  // resolved episodes per score band
var array<int> bandHit = array.from(0, 0, 0, 0, 0)  // of those, the level was reached
var int nNeither = 0                                // episodes unresolved at session close

bandOf(float s) => s < 0.2 ? 0 : s < 0.4 ? 1 : s < 0.6 ? 2 : s < 0.8 ? 3 : 4

// ------------------------------- the model ------------------------------------------
scoreOf(float distAtr, float distTicks, float leftStr, float prom, float ageS, float tests,
         float atrN, float sd, float rPos, float bL, float bA, float bP) =>
    z  = C_INT
    z += W_01 * (distAtr   - M_01) / S_01
    z += W_02 * (distTicks - M_02) / S_02
    z += W_03 * (leftStr   - M_03) / S_03
    z += W_04 * (prom      - M_04) / S_04
    z += W_05 * (ageS      - M_05) / S_05
    z += W_06 * (tests     - M_06) / S_06
    z += W_07 * (atrN      - M_07) / S_07
    z += W_08 * (sd        - M_08) / S_08
    z += W_09 * (rPos      - M_09) / S_09
    z += W_10 * (bL        - M_10) / S_10
    z += W_11 * (bA        - M_11) / S_11
    z += W_12 * (bP        - M_12) / S_12
    1.0 / (1.0 + math.exp(-z))

// A level counts as reached only when price trades THROUGH it by at least one tick.
// A touch does not count. This is the owner's rule and it is what the model was trained on.
tradedThrough(float lvl, int sd) =>
    sd == 1 ? high >= lvl + tick - eps : low <= lvl - tick + eps

finish(Cand c, color col, string glyph) =>
    keepLine = showResolved
    keepLabel = showResolved and not na(c.epScore) and c.epScore >= minLabel
    if not na(c.ln) and keepLine
        line.set_x2(c.ln, bar_index)
        line.set_color(c.ln, col)
    if not na(c.ln) and not keepLine
        line.delete(c.ln)
        c.ln := na
    if not na(c.lb) and keepLabel
        label.set_x(c.lb, bar_index)
        label.set_text(c.lb, glyph + " " + str.tostring(math.round(c.epScore * 100)) + "%")
        label.set_textcolor(c.lb, col)
    if not na(c.lb) and not keepLabel
        label.delete(c.lb)
        c.lb := na

// =====================================================================================
// PHASE 0 - the session cap. An episode still running when a new session starts ended as
//           "neither". That does NOT kill the level: it is scored again this session.
// =====================================================================================
if newSession and array.size(cands) > 0
    for i = 0 to array.size(cands) - 1
        c = array.get(cands, i)
        if c.epOpen
            c.epOpen := false
            nNeither += 1

// =====================================================================================
// PHASE 1 - resolve running episodes on this bar. Invalidation is checked first, so a bar
//           that does both counts as invalidated: the worst case for the trader.
// =====================================================================================
if array.size(cands) > 0
    for i = 0 to array.size(cands) - 1
        c = array.get(cands, i)
        if c.epOpen and c.confBar < bar_index
            invalidated = tradedThrough(c.refLvl, c.refSide)
            reached     = tradedThrough(c.lvl, c.side)
            if invalidated or reached
                b = bandOf(c.epScore)
                array.set(bandN, b, array.get(bandN, b) + 1)
                if invalidated
                    finish(c, C_MISSED, "✗")
                else
                    array.set(bandHit, b, array.get(bandHit, b) + 1)
                    c.levelAlive := false
                    finish(c, C_REACHED, "✓")
                c.epOpen   := false
                c.tracking := false

// =====================================================================================
// PHASE 2 - a level traded through while no episode was running has been reached anyway.
//           It stops being a draw and stops being an invalidation reference.
// =====================================================================================
if array.size(cands) > 0
    for i = 0 to array.size(cands) - 1
        c = array.get(cands, i)
        if c.levelAlive and not c.epOpen and c.confBar < bar_index and tradedThrough(c.lvl, c.side)
            c.levelAlive := false
            if c.tracking
                c.tracking := false
                finish(c, C_STALE, "–")

// =====================================================================================
// PHASE 3 - count approaches that came within 1 ATR but did not trade through
// =====================================================================================
if array.size(cands) > 0 and not na(atr)
    for i = 0 to array.size(cands) - 1
        c = array.get(cands, i)
        if c.tracking and c.confBar < bar_index
            if c.side == 1 and high >= c.lvl - TESTS_BAND_ATR * atr and high < c.lvl + tick - eps
                c.tests += 1
            else if c.side == -1 and low <= c.lvl + TESTS_BAND_ATR * atr and low > c.lvl - tick + eps
                c.tests += 1

// =====================================================================================
// PHASE 4 - confirm a new pivot. The floor is the weakest usable swing: a bar whose high is
//           strictly above the single bar on each side, mirrored for lows; ties disqualify.
//           Swing STRENGTH is not filtered here - it is measured and fed to the model, which
//           decides how much it matters. The pivot sits one bar back and can only be known
//           now, at this bar's close, so nothing here looks ahead.
// =====================================================================================
mkCand(int sd) =>
    lvl = sd == 1 ? high[1] : low[1]
    k = 0
    for j = 2 to STRENGTH_CAP + 1
        if not (sd == 1 ? high[j] < lvl - eps : low[j] > lvl + eps)
            break
        k += 1
    nb = sd == 1 ? math.max(high[2], high[0]) : math.min(low[2], low[0])
    pr = na(atr[1]) or atr[1] <= 0 ? 0.0 : (sd == 1 ? lvl - nb : nb - lvl) / atr[1]
    Cand.new(lvl = lvl, side = sd, confBar = bar_index, leftStr = k, prom = pr)

if not na(atr[1]) and bar_index > STRENGTH_CAP + 3
    if high[1] > high[2] + eps and high[1] > high[0] + eps
        array.push(cands, mkCand(1))
    if low[1] < low[2] - eps and low[1] < low[0] - eps
        array.push(cands, mkCand(-1))

// Drop candidates that can never matter again: not scored, and their level already reached.
// Their drawing, if any, is already finished and stays on the chart until Pine prunes it.
if array.size(cands) > 0
    for i = array.size(cands) - 1 to 0
        c = array.get(cands, i)
        if not c.tracking and not c.levelAlive
            array.remove(cands, i)
while array.size(cands) > maxTracked
    old = array.shift(cands)
    line.delete(old.ln)
    label.delete(old.lb)

// =====================================================================================
// PHASE 5 - decision points. A candidate is scored when it is confirmed, and again at the
//           first bar of every later session, exactly as in the research code. The
//           invalidation reference is the most recent opposite-side level still alive,
//           computed once per bar because it is the same for every candidate on that side.
// =====================================================================================
float refHi = na   // most recent living pivot HIGH  - the reference for low-side draws
float refLo = na   // most recent living pivot LOW   - the reference for high-side draws
if array.size(cands) > 0
    for i = array.size(cands) - 1 to 0
        c = array.get(cands, i)
        if c.levelAlive
            if c.side == 1 and na(refHi)
                refHi := c.lvl
            if c.side == -1 and na(refLo)
                refLo := c.lvl

if not na(atrNorm) and not na(atr) and atr > 0 and array.size(cands) > 0
    for i = 0 to array.size(cands) - 1
        c = array.get(cands, i)
        if c.tracking and c.levelAlive and not c.epOpen and (c.confBar == bar_index or newSession)
            if c.confBar != bar_index
                c.ageSess += 1
            retire = c.ageSess >= RETIRE_SESSION
            if retire
                c.tracking := false
                finish(c, C_STALE, "–")
            if not retire
                rl = c.side == 1 ? refLo : refHi
                rs = c.side == 1 ? -1 : 1
                if not na(rl)
                    dist = c.side == 1 ? c.lvl - close : close - c.lvl
                    p = scoreOf(dist / atr, dist / tick, c.leftStr, c.prom, c.ageSess, c.tests,
                                 atrNorm, c.side, rngPos, bLondon, bNyAm, bNyPm)
                    c.epScore := p
                    c.refLvl  := rl
                    c.refSide := rs
                    c.epOpen  := true
                    if showAlive and p >= minDraw
                        col = color.from_gradient(p, 0.2, 0.9, C_LOW, C_HIGH)
                        wid = p >= 0.8 ? 3 : p >= 0.6 ? 2 : 1
                        if na(c.ln)
                            c.ln := line.new(c.confBar - 1, c.lvl, bar_index, c.lvl,
                                 xloc = xloc.bar_index, color = col, width = wid,
                                 force_overlay = true)
                        if not na(c.ln)
                            line.set_color(c.ln, col)
                            line.set_width(c.ln, wid)
                        if p >= minLabel
                            txt = str.tostring(math.round(p * 100)) + "%"
                            if na(c.lb)
                                c.lb := label.new(bar_index, c.lvl, txt, xloc = xloc.bar_index,
                                     style = c.side == 1 ? label.style_label_down : label.style_label_up,
                                     color = color.new(color.white, 100), textcolor = col,
                                     size = size.small, force_overlay = true)
                            if not na(c.lb)
                                label.set_text(c.lb, txt)
                                label.set_textcolor(c.lb, col)

// stretch live drawings to the current bar
if array.size(cands) > 0
    for i = 0 to array.size(cands) - 1
        c = array.get(cands, i)
        if c.tracking and not na(c.ln)
            line.set_x2(c.ln, bar_index)
            if not na(c.lb)
                label.set_x(c.lb, bar_index)

// =====================================================================================
// PHASE 6 - the confirmation table. Did high scores really get reached more often?
// =====================================================================================
var table t = table.new(position.top_right, 4, 8, border_width = 1)

if showTable and barstate.islast
    table.set_position(t, tablePos == "Top right" ? position.top_right : tablePos == "Bottom right" ? position.bottom_right : position.bottom_left)
    table.set_bgcolor(t, C_SURFACE)
    table.set_frame_color(t, C_FRAME)
    table.set_frame_width(t, 1)
    table.set_border_color(t, C_FRAME)
    table.cell(t, 0, 0, "Model score", text_color = C_INK, text_size = size.small, bgcolor = C_HEAD)
    table.cell(t, 1, 0, "Episodes",    text_color = C_INK, text_size = size.small, bgcolor = C_HEAD)
    table.cell(t, 2, 0, "Reached",     text_color = C_INK, text_size = size.small, bgcolor = C_HEAD)
    table.cell(t, 3, 0, "Hit rate",    text_color = C_INK, text_size = size.small, bgcolor = C_HEAD)
    names = array.from("0-20%", "20-40%", "40-60%", "60-80%", "80-100%")
    totN = 0
    totH = 0
    for b = 0 to 4
        n = array.get(bandN, b)
        h = array.get(bandHit, b)
        totN += n
        totH += h
        rate = n > 0 ? str.tostring(math.round(100.0 * h / n)) + "%" : "-"
        shade = color.from_gradient(b, 0, 4, C_SURFACE, C_TINT)
        table.cell(t, 0, b + 1, array.get(names, b), text_color = C_INK,  text_size = size.small, bgcolor = shade)
        table.cell(t, 1, b + 1, str.tostring(n),     text_color = C_INK2, text_size = size.small, bgcolor = shade)
        table.cell(t, 2, b + 1, str.tostring(h),     text_color = C_INK2, text_size = size.small, bgcolor = shade)
        table.cell(t, 3, b + 1, rate,                text_color = C_INK,  text_size = size.small, bgcolor = shade)
    table.cell(t, 0, 6, "All (base rate)",  text_color = C_INK,  text_size = size.small, bgcolor = C_SURFACE)
    table.cell(t, 1, 6, str.tostring(totN), text_color = C_INK2, text_size = size.small, bgcolor = C_SURFACE)
    table.cell(t, 2, 6, str.tostring(totH), text_color = C_INK2, text_size = size.small, bgcolor = C_SURFACE)
    table.cell(t, 3, 6, totN > 0 ? str.tostring(math.round(100.0 * totH / totN)) + "%" : "-", text_color = C_INK, text_size = size.small, bgcolor = C_SURFACE)
    table.cell(t, 0, 7, "Unresolved at session close: " + str.tostring(nNeither) + " (excluded, as in training)",
         text_color = C_INK2, text_size = size.tiny, bgcolor = C_SURFACE)
    table.cell(t, 1, 7, "", bgcolor = C_SURFACE)
    table.cell(t, 2, 7, "", bgcolor = C_SURFACE)
    table.cell(t, 3, 7, "", bgcolor = C_SURFACE)
